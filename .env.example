# Production uses Gnani for speech and Gemini as the primary reasoner.
# OpenRouter is used only as a fallback when Gemini returns a retryable error.
AI_PROVIDER=gnani
AI_REASONER=gemini
AI_REASONER_TRACE=0

# OpenRouter is a server-side fallback reasoner. Use a :free model unless you explicitly approve paid usage.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Gemini is the production primary. Both provider keys must remain server-side.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free
# Optional free image-capable fallback models; tried in order if the primary is unavailable or returns invalid output.
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_API_KEY=

# Supabase project root URL (for example https://<project>.supabase.co); do not append /rest/v1.
# The anon/publishable key is public. Copy both values to .env.local or Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set a random secret (at least 16 characters) in Vercel Production for the daily Supabase cron.
# Vercel sends it to /api/cron/supabase-keepalive as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Set only after brand/domain review and public HTTPS deployment. Enables canonical URLs and indexing.
NEXT_PUBLIC_SITE_URL=

# Server-side only. Required when AI_PROVIDER=gnani; never prefix NEXT_PUBLIC_.
GNANI_API_KEY=
