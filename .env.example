# Mock is the safe default for voice and intent reasoning.
AI_PROVIDER=mock
AI_REASONER=mock

# OpenRouter is an optional server-side reasoner. Use a :free model unless you explicitly approve paid usage.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: set AI_REASONER=gemini to use free-tier Gemini 3.5 Flash Lite first.
# OpenRouter remains the fallback and both keys stay server-side.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free
# Optional free image-capable fallback models; tried in order if the primary is unavailable or returns invalid output.
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_API_KEY=

# Supabase project URL and public anon/publishable key. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set only after brand/domain review and public HTTPS deployment. Enables canonical URLs and indexing.
NEXT_PUBLIC_SITE_URL=

# Server-side only. Required when AI_PROVIDER=gnani; never prefix NEXT_PUBLIC_.
GNANI_API_KEY=
